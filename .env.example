# --- Database (Supabase Postgres on supascale) ---
# Self-hosted Supabase goes through Supavisor: user must be postgres.<POOLER_TENANT_ID> (default your-tenant-id). 56329 = transaction pool, 56322 = session pool.
DATABASE_URL=postgres://postgres.your-tenant-id:PASSWORD@45.63.13.90:56329/postgres

# --- Object storage: Supabase Storage S3 gateway (backed by Cloudflare R2 via supascale) ---
STORAGE_S3_ENDPOINT=http://45.63.13.90:56321/storage/v1/s3
STORAGE_S3_REGION=auto
STORAGE_BUCKET=mail
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- App ---
APP_URL=https://mail.example.com
# Shared secret between this app and cloudflare-worker/ (inbound POSTs + outbound /send)
EDGE_WORKER_SECRET=
EDGE_WORKER_URL=https://mailflare-edge.<account>.workers.dev

# --- Cloudflare API (zone + Email Routing management only) ---
CF_TOKEN=
CF_API_KEY=
CF_EMAIL=
CF_AID=
CF_EMAIL_WORKER_NAME=mailflare-edge

# --- Optional ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
GITHUB_UPDATE_TOKEN=
GITHUB_UPDATE_REPO=
GITHUB_UPDATE_REF=
